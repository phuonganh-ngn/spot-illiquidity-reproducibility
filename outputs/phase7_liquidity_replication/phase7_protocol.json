{
  "protocol_id": "phase7_liquidity_generalization_001",
  "purpose": "Out-of-period and cross-asset validation of Phase-6 24-hour future Amihud predictive value, plus distinct liquidity-proxy validation",
  "claim_type": "forecasting only; no causal identification",
  "asset_selection": {
    "assets": ["BTC", "ETH", "SOL", "BNB", "XRP"],
    "rule": "all and only assets passing the pre-existing outcome-blind coverage and fixed timestamp-map eligibility rules",
    "external_outcomes_may_change_asset_set": false
  },
  "frequency": "4-hour UTC",
  "development_sample": {
    "feature_start_inclusive": "2021-12-01T00:00:00Z",
    "last_permitted_feature_interval_start": "2023-06-30T20:00:00Z",
    "label_window_must_remain_inside_development_calendar": true,
    "prior_stage6_test_period_reused_for_tuning": false
  },
  "prior_stage6_test_exclusion": {
    "start": "2023-07-01T00:00:00Z",
    "end": "2024-03-03T20:00:00Z",
    "role": "sealed gap; excluded from new Phase-7 tuning and primary external evaluation because previously inspected in Stage 6"
  },
  "external_evaluation": {
    "feature_start_inclusive": "2024-03-04T00:00:00Z",
    "last_feature_interval_start": "2026-09-29T20:00:00Z",
    "last_future_interval_start": "2026-09-30T20:00:00Z",
    "one_pass_only": true,
    "outcomes_parsed_during_development_selection": false
  },
  "future_window": {
    "intervals": 6,
    "hours": 24,
    "starts": "t+1",
    "ends": "t+6 inclusive",
    "post_sample_labels": "missing; never extrapolated"
  },
  "targets": [
    {
      "id": "future_amihud_24h_mean",
      "definition": "mean of 4-hour 1e6*abs(log(close_t/close_t-1))/spot_quote_volume_USDT over t+1:t+6",
      "primary_validation_target": true
    },
    {
      "id": "future_kyle_abs_lambda_24h",
      "definition": "absolute 5-minute OLS slope of future log return on signed USDT quote flow over 288 bars t+1:t+6; price-impact proxy",
      "primary_validation_target": false
    },
    {
      "id": "future_corwin_schultz_spread_24h",
      "definition": "mean of five Corwin-Schultz high-low estimates from adjacent 4-hour bars fully within t+1:t+6; range-based spread proxy",
      "primary_validation_target": false
    }
  ],
  "transform_candidates": ["raw_nonnegative", "log1p_y", "log1p_y_over_train_median_positive"],
  "transform_selection": "development-only expanding-fold validation; pool normalized original-scale MAE over learned families and matched information sets by asset-target; one selected transform shared by both information sets; scaling constant learned inside each train fold",
  "information_sets": {
    "legacy_spot_only": {
      "base_variables": ["spot_return", "spot_realized_volatility", "spot_downside_semivariance", "spot_amihud", "spot_taker_imbalance", "spot_quote_volume_growth"],
      "lags": [0, 1, 2, 3, 4, 5]
    },
    "legacy_spot_plus_derivatives": {
      "adds": ["funding_rate_state", "oi_log_change", "futures_taker_imbalance", "basis_mean"],
      "lags": [0, 1, 2, 3, 4, 5]
    },
    "enhanced_spot_only": {
      "adds_to_legacy_spot_only": ["utc_slot_indicators", "weekday_indicators"]
    },
    "enhanced_spot_plus_derivatives": {
      "adds_to_enhanced_spot_only": ["funding_change", "basis_change", "oi_shock", "flow_shock", "funding_basis_interaction", "funding_oishock_interaction", "oishock_flow_interaction", "flow_basis_interaction"]
    }
  },
  "development_folds": [
    {"fold": "F1", "train_start": "2021-12-01T00:00:00Z", "validation_start": "2022-10-01T00:00:00Z", "validation_end_exclusive": "2023-01-01T00:00:00Z"},
    {"fold": "F2", "train_start": "2021-12-01T00:00:00Z", "validation_start": "2023-01-01T00:00:00Z", "validation_end_exclusive": "2023-04-01T00:00:00Z"},
    {"fold": "F3", "train_start": "2021-12-01T00:00:00Z", "validation_start": "2023-04-01T00:00:00Z", "validation_end_exclusive": "2023-07-01T00:00:00Z"}
  ],
  "families": {
    "Ridge": {"category": "linear", "configs": [{"alpha": 0.1}, {"alpha": 1.0}, {"alpha": 10.0}]},
    "RBF_SVR": {"category": "kernel", "configs": [{"C": 0.1, "epsilon": 0.05, "gamma": "scale"}, {"C": 1.0, "epsilon": 0.05, "gamma": "scale"}, {"C": 10.0, "epsilon": 0.05, "gamma": "scale"}]},
    "ExtraTrees": {"category": "bagged_trees", "configs": [{"n_estimators": 200, "min_samples_leaf": 2}, {"n_estimators": 200, "min_samples_leaf": 5}, {"n_estimators": 200, "min_samples_leaf": 10}]},
    "HistGradientBoosting": {"category": "boosting", "configs": [{"learning_rate": 0.05, "max_iter": 100, "max_leaf_nodes": 7}, {"learning_rate": 0.05, "max_iter": 100, "max_leaf_nodes": 15}, {"learning_rate": 0.05, "max_iter": 100, "max_leaf_nodes": 31}]},
    "MLP": {"category": "neural", "configs": [{"hidden_layer_sizes": [8], "alpha": 0.001, "max_iter": 400}, {"hidden_layer_sizes": [16], "alpha": 0.001, "max_iter": 400}, {"hidden_layer_sizes": [32], "alpha": 0.001, "max_iter": 400}]},
    "GRU": {"category": "neural", "configs": [{"hidden_size": 8, "epochs": 20, "weight_decay": 0.001}]}
  },
  "preprocessing": "No imputation. Same target-specific complete rows for matched information-set pairs. StandardScaler fit inside each fold for Ridge, SVR, MLP and GRU. Trees receive unscaled values. No full-sample scaling.",
  "development_selection": {
    "configuration_metric": "pooled expanding-fold transformed-target MAE",
    "target_transform_metric": "pooled normalized original-scale MAE across learned families and both information sets",
    "tie_rule": "first/simplest configuration in registry order",
    "refit": "selected config fit once on eligible development rows; new external sample evaluated once"
  },
  "external_primary_metric": "MAE on frozen transformed target",
  "external_secondary_metrics": ["original_scale_MAE", "original_scale_RMSE", "Amihud_stress_precision_recall_lift"],
  "incremental_loss": "loss(Spot+Derivatives)-loss(Spot-only); negative favors derivatives",
  "bootstrap": {"method": "paired moving date-block bootstrap", "replications": 2000, "seed": 724051, "block_length_4h_intervals": 42, "paired_across_information_sets": true},
  "multiplicity": "Holm adjustment across six learned model families within each asset-target comparison; MLP and GRU are one independent family category",
  "stress_warning": {"actual_event_threshold": "development target 90th percentile", "prediction_alarm_threshold": "development OOF forecast 90th percentile", "metrics": ["precision", "recall", "F1", "lift"]},
  "temporal_stability_segments": ["2024-03-04/2024-12-31", "2025-01-01/2025-12-31", "2026-01-01/2026-09-30"],
  "negative_controls": ["future derivatives after the 24-hour target window predicting the earlier target; diagnostic only", "fixed 42-interval circular displacement of derivative information; diagnostic only"],
  "interpretation": "predictive association only; no causal effect language",
  "no_external_data_download": true,
  "random_seeds": {"ExtraTrees": 724051, "MLP": 724052, "GRU": 724053, "bootstrap": 724051}
}
